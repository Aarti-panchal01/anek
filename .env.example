# Gnani (get from app.gnani.ai -> API Keys)
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai

# Sarvam translation keys rotate when an individual key is rejected or quota-limited.
SARVAM_API_KEY_1=
SARVAM_API_KEY_2=
SARVAM_API_KEY_3=
SARVAM_API_KEY_4=
SARVAM_API_KEY_5=
# Backward-compatible single-key fallback when numbered keys are not configured.
SARVAM_API_KEY=
SARVAM_TRANSLATION_MODEL=mayura:v1
SARVAM_REWRITE_MODEL=sarvam-105b-conversations

# Hosted deployment (leave auth disabled for local development)
ANEK_DATA_DIR=data
REQUIRE_ACCESS_AUTH=false
ANEK_ACCESS_PASSWORD=
ANEK_AUTH_SECRET=
CORS_ORIGINS=
CORS_ORIGIN_REGEX=

# Safety and cost caps
MAX_VIDEO_SECONDS=120
EXPORT_RETENTION_HOURS=24
GNANI_DAILY_LIMIT=2500
MAX_CREDITS_PER_JOB=0
PER_IP_LIMITS=voice_clones=3,previews=30,jobs=5

# Product behavior
APP_NAME=Anek
NUMERAL_STYLE=ascii
ENABLED_LANGS=bn-IN,en-IN,gu-IN,hi-IN,kn-IN,ml-IN,mr-IN,pa-IN,ta-IN,te-IN
LOW_TRUST_VERIFY_LANGS=mr-IN,pa-IN
FIT_TOLERANCE=1.15
MAX_STRETCH=1.15
SIMILARITY_THRESHOLD=0.70
CONSENT_MATCH_THRESHOLD=85

# Dev: use mocks so tests never spend credits
GNANI_MOCK=0
LLM_MOCK=0
