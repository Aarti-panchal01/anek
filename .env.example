# Gnani (get from app.gnani.ai -> API Keys)
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai

# Translation / Brain LLM (any OpenAI-compatible endpoint)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Preferred key pool; comma-separated. Falls back to LLM_API_KEY when empty.
GROQ_API_KEYS=
LLM_API_KEY=
# Gemini translation default; Groq remains the independent cleanup/check model.
LLM_2_API_KEYS=
LLM_2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_2_MODEL=gemini-3.5-flash

# Primary spoken-language translation and translation-only rewrite/retry calls
SARVAM_API_KEY=
SARVAM_TRANSLATION_MODEL=mayura:v1
# The available Sarvam SDK does not expose the requested 30B model; use its supported chat model.
SARVAM_REWRITE_MODEL=sarvam-105b-conversations
# Optional; defaults to the ignored data/llm_response_cache.sqlite3
LLM_CACHE_PATH=data/llm_response_cache.sqlite3

# Hosted deployment (leave auth disabled for local development)
ANEK_DATA_DIR=data
REQUIRE_ACCESS_AUTH=false
ANEK_ACCESS_PASSWORD=
ANEK_AUTH_SECRET=
CORS_ORIGINS=
CORS_ORIGIN_REGEX=

# Safety and cost caps
MAX_VIDEO_SECONDS=120
EXPORT_RETENTION_HOURS=24
GNANI_DAILY_LIMIT=2500
MAX_CREDITS_PER_JOB=0

# Product behavior
APP_NAME=Anek
STT_MODEL=prisma-v3.0
VERIFY_STT_MODEL=prisma-v3.0
NUMERAL_STYLE=ascii
ENABLED_LANGS=bn-IN,en-IN,gu-IN,hi-IN,kn-IN,ml-IN,mr-IN,pa-IN,ta-IN,te-IN
LOW_TRUST_VERIFY_LANGS=mr-IN,pa-IN
FIT_TOLERANCE=1.15
MAX_STRETCH=1.15
SIMILARITY_THRESHOLD=0.70
CONSENT_MATCH_THRESHOLD=85

# Dev: use mocks so tests never spend credits
GNANI_MOCK=0
LLM_MOCK=0
