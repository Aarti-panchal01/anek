# Gnani (get from app.gnani.ai -> API Keys)
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai

# Translation / Brain LLM (any OpenAI-compatible endpoint)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# Safety and cost caps
MAX_VIDEO_SECONDS=120
GNANI_DAILY_LIMIT=300
MAX_CREDITS_PER_JOB=400

# Product behavior
APP_NAME=Anek
STT_MODEL=prisma-v2.5
VERIFY_STT_MODEL=prisma-v3.0
NUMERAL_STYLE=ascii
ENABLED_LANGS=bn-IN,en-IN,gu-IN,hi-IN,kn-IN,ml-IN,mr-IN,pa-IN,ta-IN,te-IN
FIT_TOLERANCE=1.15
MAX_STRETCH=1.15
SIMILARITY_THRESHOLD=0.70
CONSENT_MATCH_THRESHOLD=85

# Dev: use mocks so tests never spend credits
GNANI_MOCK=0
LLM_MOCK=0
